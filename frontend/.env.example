# Firebase / Firestore — récupérer ces valeurs dans la console Firebase
# Project Settings > General > Your apps > Firebase SDK snippet
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# --- Développement local avec émulateur ---
# Les valeurs ci-dessous permettent de lancer l'émulateur SANS vrai projet GCP.
# Remplacer VITE_FIREBASE_PROJECT_ID par le nom de votre choix (ex: rdv-dev).
# L'émulateur accepte n'importe quelle valeur pour les autres champs.
#
# VITE_FIREBASE_API_KEY=fake-api-key
# VITE_FIREBASE_AUTH_DOMAIN=rdv-dev.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=rdv-dev
# VITE_FIREBASE_STORAGE_BUCKET=rdv-dev.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000

# Port local (optionnel)
FRONTEND_PORT=4200
